# Required: the password you use to sign in to the inbox app.
ADMIN_PASSWORD=change-me-to-something-long

# The public URL of this chat server (used in notification links).
PUBLIC_URL=https://chat.dorianmediagroup.com

# Websites allowed to load the chat widget (comma separated).
ALLOWED_ORIGINS=https://dorianmediagroup.com,https://www.dorianmediagroup.com

# Contact address for the push services (any email you own).
VAPID_SUBJECT=mailto:evan@dorianmediagroup.com

# Where the SQLite database lives. Point this at a persistent disk/volume.
DATA_DIR=/data

# Optional backup notifications through the free ntfy app (https://ntfy.sh).
# Pick a long, hard-to-guess topic name and subscribe to it in the ntfy app.
# NTFY_TOPIC=dmg-chat-7f3k9q2x
