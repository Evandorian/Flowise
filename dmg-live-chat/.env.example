# ---------------------------------------------------------------- required
# The password you use to sign in to the DMG Chat app.
ADMIN_PASSWORD=change-me-to-something-long

# The public URL of this chat server.
PUBLIC_URL=https://chat.dorianmediagroup.com

# Your website (used for "continue the chat" links in follow-up emails).
SITE_URL=https://dorianmediagroup.com

# Websites allowed to load the chat (comma separated).
ALLOWED_ORIGINS=https://dorianmediagroup.com,https://www.dorianmediagroup.com

# Contact address for the push notification services.
VAPID_SUBJECT=mailto:evan@dorianmediagroup.com

# Where the database and shared files live. Point this at the persistent volume.
DATA_DIR=/data

# ---------------------------------------------------------------- email
# Used to email your replies to visitors who left, and to alert you when a
# message sits unread for 5 minutes. Any SMTP provider works (Google Workspace,
# SendLayer, Brevo, Postmark...). Leave SMTP_HOST empty to turn email off.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Evan Dorian <evan@dorianmediagroup.com>"
ADMIN_EMAIL=evan@dorianmediagroup.com

# ---------------------------------------------------------------- MailerLite
# MailerLite > Integrations > API > Generate new token.
MAILERLITE_API_KEY=
# The "Website Chat Leads" group.
MAILERLITE_GROUP_ID=201884295510361592

# ---------------------------------------------------------------- AI suggested replies
# console.anthropic.com > API keys. Leave empty to hide the suggest button.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- optional
# Seconds before the automatic "I'll reply shortly" message (0 = off).
# AUTO_REPLY_SECONDS=180
# AUTO_REPLY_TEXT="Thanks for your message! I'm finishing up with a client and will reply shortly. If you need to step away, leave your email and I'll follow up there."
# Backup push notifications through the free ntfy app (https://ntfy.sh).
# NTFY_TOPIC=dmg-chat-7f3k9q2x
